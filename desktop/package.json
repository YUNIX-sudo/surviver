{
  "name": "surviver-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Surviver desktop client (Electron wrapper around the web client)",
  "author": "Surviver",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "software.yunix.surviver",
    "productName": "Surviver",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "app/**/*"],
    "win": { "target": "portable", "artifactName": "Surviver-portable.exe" },
    "portable": { "artifactName": "Surviver-portable.exe" },
    "mac": { "target": "dir" }
  }
}
